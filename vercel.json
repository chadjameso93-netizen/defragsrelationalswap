{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/.next",
  "redirects": [
    { "source": "/", "destination": "/studio", "permanent": false },
    { "source": "/home", "destination": "/studio", "permanent": false },
    { "source": "/landing", "destination": "/studio", "permanent": false },
    { "source": "/login", "destination": "/signin/studio", "permanent": false },
    { "source": "/signin", "destination": "/signin/studio", "permanent": false },
    { "source": "/signup", "destination": "/signup/studio", "permanent": false },
    { "source": "/account", "destination": "/app/studio", "permanent": false },
    { "source": "/app", "destination": "/app/studio", "permanent": false },
    { "source": "/membership", "destination": "/billing/studio", "permanent": false },
    { "source": "/billing", "destination": "/billing/studio", "permanent": false },
    { "source": "/workspace", "destination": "/workspace/studio", "permanent": false },
    { "source": "/workspace/final", "destination": "/workspace/studio", "permanent": false },
    { "source": "/companion", "destination": "/workspace/studio", "permanent": false },
    { "source": "/world", "destination": "/workspace/studio", "permanent": false },
    { "source": "/dynamics", "destination": "/workspace/studio", "permanent": false }
  ]
}
